{
  "name": "omnisearch-sdk",
  "version": "4.1.0",
  "description": "TypeScript SDK for web search providers",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "type-check": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --write .",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbks121/omnisearch-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/gbks121/omnisearch-sdk/issues"
  },
  "homepage": "https://github.com/gbks121/omnisearch-sdk#readme",
  "keywords": [
    "search",
    "api",
    "sdk",
    "typescript",
    "web search"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.2",
    "dotenv": "^18.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "p-map": "^7.0.8",
    "p-retry": "^8.0.1",
    "p-throttle": "^8.1.1",
    "p-timeout": "^7.0.2",
    "zod": "^4.6.5"
  },
  "lint-staged": {
    "*.{ts,js,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "overrides": {
    "minimatch": "^10.2.4"
  }
}
